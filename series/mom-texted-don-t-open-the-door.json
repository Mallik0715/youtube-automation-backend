            },
            {
              "speaker": "N",
              "text": "He pressed his chest to the rug and held his breath.",
              "emotion": "scared",
              "focus": "A"
            }
          ],
          "seated": []
        }
      ],
      "segments": [
        {
          "scene": "bedroom",
