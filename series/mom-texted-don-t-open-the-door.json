    {
      "title": "Don't Open The Door",
      "recap": "Milo's mom texted from her night shift: Don't open the door. Whatever is downstairs is not me. Then her voice called his name from the hallway.",
      "hook": "His mom sent a *terrifying text* from work.",
      "choice": {
        "question": "What would you do?",
        "a": "Call Mom to check if she is really still at work",
        "b": "Hide under the bed and stay completely silent"
      },
      "segments": [
        {
          "scene": "bedroom",
          "night": true,
          "cast": [
            "A"
          ],
          "lines": [
            {
              "speaker": "N",
              "text": "At two fourteen in the morning, Milo's phone screen lit up.",
              "emotion": "neutral",
              "focus": "A"
            },
            {
              "speaker": "N",
              "text": "The text was from his mom on her hospital night shift.",
              "emotion": "worried",
              "focus": "A"
            },
            {
              "speaker": "N",
              "text": "It read: Do not open the door for me tonight.",
              "emotion": "scared",
              "focus": "A"
            },
            {
              "speaker": "N",
              "text": "A second message flashed immediately after.",
              "emotion": "scared",
              "focus": "A"
            },
            {
              "speaker": "N",
              "text": "I am still at work. Whatever is downstairs is not me.",
              "emotion": "scared",
              "focus": "A",
              "sfx": "knock"
            },
            {
              "speaker": "N",
              "text": "Downstairs, heavy metal keys jingled in the front lock.",
              "emotion": "worried",
              "focus": "A",
              "sfx": "footsteps"
            },
            {
              "speaker": "N",
              "text": "Then, his mother's exact voice called out his name from the hallway.",
              "emotion": "scared",
              "focus": "A"
            },
            {
              "speaker": "A",
              "text": "Mom? Is that really you?",
              "emotion": "crying"
            },
            {
              "speaker": "N",
              "text": "A final text popped up on his screen.",
              "emotion": "scared",
              "focus": "A"
            },
            {
              "speaker": "N",
              "text": "The note said: Don't answer. It learns your voice.",
              "emotion": "scared",
              "fx": "shake",
              "focus": "A"
            }
          ]
        }
      ]
    },
    {
      "title": "Backwards Feet",
      "recap": "Milo hid under his bed, saw backwards feet, received conflicting texts, and heard a horn outside.",
      "hook": "Those aren't *Mom's feet*.",
      "choice": {
        "question": "What would you do?",
        "a": "Jump out the window and run to the car",
        "b": "Stay frozen and trust the unknown number"
      },
      "follows": "b",
