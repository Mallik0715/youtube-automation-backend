          "cast": [
            "A",
            "C"
          ],
          "lines": [
            {
              "speaker": "N",
              "text": "Slow steps entered the room. The wooden door creaked.",
              "emotion": "scared",
              "focus": "C",
              "sfx": "knock"
            },
            {
              "speaker": "N",
              "text": "Two feet stopped beside the bed in Mom's blue slippers.",
              "emotion": "worried",
              "focus": "C"
            },
            {
              "speaker": "N",
              "text": "The heels faced forward. The toes pointed backward.",
              "emotion": "scared",
              "fx": "shake",
              "focus": "C"
            },
            {
              "speaker": "C",
              "text": "Milo... I know you're here.",
              "emotion": "scared"
            }
          ]
        },
        {
          "scene": "bedroom",
          "night": true,
          "cast": [
            "A"
          ],
          "lines": [
            {
              "speaker": "N",
              "text": "Milo's phone glowed on the rug. A text from Mom.",
