{
  "name": "youtube-automation-backend",
  "version": "1.0.0",
  "description": "Automated YouTube Shorts pipeline: Groq script → Pixabay clips → edge-tts voice → FFmpeg → YouTube upload",
  "main": "pipeline.js",
  "scripts": {
    "start": "node pipeline.js",
    "auth": "node server.js --auth",
    "auth:cli": "node config/getRefreshToken.js",
    "dev": "nodemon server.js",
    "skit": "node skit.js",
    "studio": "remotion studio remotion/index.jsx --public-dir=assets",
    "series": "node skit.js --series",
    "check:series": "node scripts/checkSeries.js",
    "make:backgrounds": "node scripts/generateBackgrounds.js",
    "make:sfx": "node scripts/generateSfx.js",
    "app": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build && node server.js",
    "app:dev": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@remotion/bundler": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/google-fonts": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "groq-sdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
